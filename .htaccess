# ==========================================
# 1. サーバー環境設定・オプション
# ==========================================
Options -Indexes
SetEnvIf Request_URI ".*" Ngx_Cache_NoCacheMode

# ==========================================
# 2. リダイレクト設定（URLの正規化）
# ==========================================
RewriteEngine on


# 2-0. index.html をドメインのみのURLにリダイレクト
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html\ HTTP/
RewriteRule ^(([^/]+/)*)index\.html$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2-1. HTTPS化
RewriteCond %{HTTPS} !on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2-2. wwwなし統一
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 2-3. リバースプロキシを設定し、保存を禁止
RewriteRule ^ad_manager/(.*)$ http://localhost:3000/$1 [P,L]
<If "%{REQUEST_URI} =~ m#^/ad_manager/#">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</If>



# ==========================================
# 3. セキュリティ設定・アクセス制限
# ==========================================
# HSTSの設定
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# ドットファイル（.htaccessなど）へのアクセス拒否
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>
<FilesMatch "^README\.md$">
    Require all denied
</FilesMatch>

# 特定ファイルのインデックス拒否（SEO対策）
<FilesMatch "\.json$">
    Header set X-Robots-Tag "noindex"
</FilesMatch>
<FilesMatch "^(header\.html|footer\.html)$">
    Header set X-Robots-Tag "noindex"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/api/#">
    Header set X-Robots-Tag "noindex"
</If>

# ==========================================
# 4. エラーページ設定
# ==========================================
ErrorDocument 403 /errorPage/403.html
ErrorDocument 404 /errorPage/404.html

# ==========================================
# 5. キャッシュ制御（Expires / Cache-Control）
# ==========================================
# 5-1. 通常ファイルのブラウザキャッシュ有効化
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 days"
    ExpiresByType text/css "access plus 1 days"
    ExpiresByType application/javascript "access plus 1 days"
    ExpiresByType application/json "access plus 1 days"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 3 days"
    ExpiresByType font/ttf "access plus 3 months"
</IfModule>

# 5-2. 特定ファイル・APIのキャッシュ無効化（常に最新を読み込ませる）
<FilesMatch "^(newsData\.json|kkContents\.json)$">        
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/api/#">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</If>
